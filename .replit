modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Global Sign Communicator AI"

[[workflows.workflow]]
name = "Global Sign Communicator AI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 backend/app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
